<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit HR Resignation Form View to add Final Settlement Actions & Smart Button -->
    <record id="view_hr_resignation_form_inherit_final_settlement" model="ir.ui.view">
        <field name="name">hr.resignation.form.inherit.final.settlement</field>
        <field name="model">hr.resignation</field>
        <field name="inherit_id" ref="hr_resignation.hr_resignation_view_form"/>
        <field name="arch" type="xml">
            <!-- Add Create Final Settlement button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_create_final_settlement"
                        string="Create Final Settlement"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ('approved', 'confirm')"/>
            </xpath>

            <!-- Add Smart Button inside sheet -->
            <xpath expr="//sheet" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_final_settlement"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calculator"
                            invisible="final_settlement_count == 0">
                        <field name="final_settlement_count" widget="statinfo" string="Final Settlement"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
