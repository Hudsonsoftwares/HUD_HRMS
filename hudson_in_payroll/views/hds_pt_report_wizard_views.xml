<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Professional Tax Report Wizard Form View -->
    <record id="hds_pt_report_wizard_view_form" model="ir.ui.view">
        <field name="name">hds.pt.report.wizard.form</field>
        <field name="model">hds.pt.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Professional Tax Report">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Report Configuration">
                            <field name="report_type"/>
                            <field name="company_id"/>
                            <field name="state_id"/>
                        </group>
                        <group string="Filter Criteria">
                            <field name="employee_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_pt_report" string="Generate Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window Action for PT Report Wizard -->
    <record id="action_hds_pt_report_wizard" model="ir.actions.act_window">
        <field name="name">Professional Tax Report Generator</field>
        <field name="res_model">hds.pt.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
