<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bonus Document List View -->
    <record id="view_hds_in_bonus_tree" model="ir.ui.view">
        <field name="name">hds.in.bonus.list</field>
        <field name="model">hds.in.bonus</field>
        <field name="arch" type="xml">
            <list string="Bonus Documents" default_order="id desc">
                <field name="name"/>
                <field name="bonus_type"/>
                <field name="payment_date"/>
                <field name="payment_method"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'submitted'"
                       decoration-warning="state == 'approved'"
                       decoration-success="state in ('processed', 'paid')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Bonus Document Form View -->
    <record id="view_hds_in_bonus_form" model="ir.ui.view">
        <field name="name">hds.in.bonus.form</field>
        <field name="model">hds.in.bonus</field>
        <field name="arch" type="xml">
            <form string="Bonus Document">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_process_bonus" string="Process Bonus" type="object" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state not in ('submitted', 'approved')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('processed', 'paid', 'cancelled')"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,processed,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payslips" type="object" class="oe_stat_button" icon="fa-money" invisible="payslip_count == 0">
                            <field name="payslip_count" widget="statinfo" string="Payslips"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Diwali Festival Bonus 2026" readonly="state in ('processed', 'paid')"/></h1>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="bonus_type" readonly="state in ('processed', 'paid')"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state in ('processed', 'paid')"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_method" readonly="state in ('processed', 'paid')"/>
                            <field name="payment_date" readonly="state in ('processed', 'paid')"/>
                            <field name="payslip_run_id" invisible="not payslip_run_id"/>
                        </group>
                        <group string="Payroll Period">
                            <field name="date_from" readonly="state in ('processed', 'paid')"/>
                            <field name="date_to" readonly="state in ('processed', 'paid')"/>
                        </group>
                    </group>
                    <group string="Employee Selection &amp; Calculation">
                        <group>
                            <field name="employee_selection_type" widget="radio" readonly="state in ('approved', 'processed', 'paid')"/>
                            <field name="employee_id" invisible="employee_selection_type != 'employee'" required="employee_selection_type == 'employee'" readonly="state in ('approved', 'processed', 'paid')"/>
                            <field name="department_id" invisible="employee_selection_type != 'department'" required="employee_selection_type == 'department'" readonly="state in ('approved', 'processed', 'paid')"/>
                            <field name="job_id" invisible="employee_selection_type != 'job'" required="employee_selection_type == 'job'" readonly="state in ('approved', 'processed', 'paid')"/>
                            <field name="target_company_id" invisible="employee_selection_type != 'company'" required="employee_selection_type == 'company'" readonly="state in ('approved', 'processed', 'paid')"/>
                        </group>
                        <group>
                            <field name="calculation_method" readonly="state in ('approved', 'processed', 'paid')"/>
                            <field name="fixed_amount" invisible="calculation_method != 'fixed'" required="calculation_method == 'fixed'" readonly="state in ('approved', 'processed', 'paid')"/>
                            <field name="percentage" invisible="calculation_method == 'fixed'" required="calculation_method != 'fixed'" readonly="state in ('approved', 'processed', 'paid')"/>
                            <div class="oe_edit_only mt-2" col="2">
                                <button name="action_generate_lines" string="Generate Bonus Lines" type="object" class="btn btn-secondary" invisible="state not in ('draft', 'submitted')"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bonus Lines" name="lines">
                            <field name="line_ids" readonly="state in ('approved', 'processed', 'paid')">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="department_id"/>
                                    <field name="job_id"/>
                                    <field name="contract_id"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="payslip_id"/>
                                    <field name="state" widget="badge" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes or references..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Bonus Document Search View -->
    <record id="view_hds_in_bonus_search" model="ir.ui.view">
        <field name="name">hds.in.bonus.search</field>
        <field name="model">hds.in.bonus</field>
        <field name="arch" type="xml">
            <search string="Search Bonus Documents">
                <field name="name" string="Bonus" filter_domain="['|', ('name', 'ilike', self), ('notes', 'ilike', self)]"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="bonus_type"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Processed" name="filter_processed" domain="[('state', '=', 'processed')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Bonus Type" name="group_by_type" context="{'group_by': 'bonus_type'}"/>
                    <filter string="Payment Method" name="group_by_method" context="{'group_by': 'payment_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Bonus Documents -->
    <record id="action_hds_in_bonus" model="ir.actions.act_window">
        <field name="name">Bonuses</field>
        <field name="res_model">hds.in.bonus</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hds_in_bonus_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Bonus Document!
            </p>
            <p>
                Bonus Management allows HR to generate festival, annual, performance, and ex-gratia bonuses for individual employees or groups, and seamlessly process them in payroll.
            </p>
        </field>
    </record>

    <!-- Submenu: Bonus Management under Payroll -> Configuration -->
    <menuitem id="menu_hds_in_bonus_config"
              name="Bonus Management"
              parent="hr_payroll_community.menu_hr_payroll_community_configuration"
              sequence="30"
              groups="hr_payroll_community.group_hr_payroll_community_manager"/>

    <!-- Menuitem: Bonuses under Bonus Management -->
    <menuitem id="menu_hds_in_bonus_list"
              name="Bonuses"
              parent="menu_hds_in_bonus_config"
              sequence="10"
              action="action_hds_in_bonus"
              groups="hr_payroll_community.group_hr_payroll_community_user"/>
</odoo>
