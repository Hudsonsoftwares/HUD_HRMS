<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Statutory PF Wage Calculation Rule -->
        <record id="hds_in_rule_pf_wage" model="hr.salary.rule">
            <field name="name">PF_WAGE</field>
            <field name="code">PF_WAGE</field>
            <field name="sequence" eval="5"/>
            <field name="category_id" ref="hudson_in_payroll.salary_rule_category_pf_calc"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
pf_wage = BASIC + DA

basis = employee.hds_in_pf_contribution_basis
if basis in ('actual_basic', 'actual_pf_wage'):
    result = pf_wage
else:
    ceiling = employee.env['hr.rule.parameter'].get_pf_parameter('PF_WAGE_CEILING')
    result = min(pf_wage, ceiling)
]]></field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Wire PF_WAGE into Base Structure -->
        <record id="hr_payroll_community.structure_base" model="hr.payroll.structure">
            <field name="rule_ids" eval="[(4, ref('hds_in_rule_pf_wage'))]"/>
        </record>
    </data>
</odoo>
