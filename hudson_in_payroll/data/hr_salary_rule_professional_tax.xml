<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Professional Tax Employee Deduction Rule (Thin HrPayslip API Delegated) -->
        <record id="hds_in_rule_pt" model="hr.salary.rule">
            <field name="name">Professional Tax</field>
            <field name="code">PT</field>
            <field name="sequence" eval="165"/>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[result = payslip_record.hds_in_compute_professional_tax()]]></field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Wire Professional Tax Rule into Standard Base Salary Structure -->
        <record id="hr_payroll_community.structure_base" model="hr.payroll.structure">
            <field name="rule_ids" eval="[(4, ref('hds_in_rule_pt'))]"/>
        </record>
    </data>
</odoo>
