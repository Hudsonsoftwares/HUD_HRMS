<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Overtime Pay Salary Rule -->
        <record id="hr_rule_overtime_pay" model="hr.salary.rule">
            <field name="name">Overtime Pay</field>
            <field name="sequence" eval="25"/>
            <field name="code">OT</field>
            <field name="category_id" ref="hr_payroll_community.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = contract.get_period_overtime_rate(payslip.date_from, payslip.date_to)
result_qty = worked_days.OVERTIME.number_of_hours if (worked_days.OVERTIME and contract.pay_by_attendance) else 0.0
            </field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

        <!-- Shortage Deduction Salary Rule -->
        <record id="hr_rule_shortage_deduction" model="hr.salary.rule">
            <field name="name">Shortage Deduction</field>
            <field name="sequence" eval="26"/>
            <field name="code">SHORT</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = -contract.get_period_shortage_rate(payslip.date_from, payslip.date_to)
result_qty = worked_days.SHORTAGE.number_of_hours if (worked_days.SHORTAGE and contract.pay_by_attendance) else 0.0
            </field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

        <!-- Unpaid Leave Deduction Salary Rule -->
        <record id="hr_payroll_community.hr_rule_unpaid" model="hr.salary.rule">
            <field name="name">Unpaid Leave Deduction</field>
            <field name="amount_python_compute">
result = -(worked_days.UNPAID.number_of_days if worked_days.UNPAID else 0.0) * (contract.hourly_rate * contract.standard_hours_per_day)
            </field>
        </record>

        <!-- Link Rules to Base Structure -->
        <record id="hr_payroll_community.structure_base" model="hr.payroll.structure">
            <field name="rule_ids" eval="[(4, ref('hr_rule_overtime_pay')), (4, ref('hr_rule_shortage_deduction')), (4, ref('hr_payroll_community.hr_rule_unpaid'))]"/>
        </record>
    </data>
</odoo>
